// Copy to dre_comm_secrets.h (git-ignored) for local builds that should log in to the DRE-Comm broker.
// CI creates this file from the DRE_MQTT_PUBLIC_PASSWORD repository secret.
// This is the shared PUBLIC device password: it ends up inside every published firmware binary,
// so treat it as "not committed", not as a real secret. Use letters and digits only.
#pragma once
#define DRE_COMM_MQTT_PASSWORD "replace-with-public-password"
